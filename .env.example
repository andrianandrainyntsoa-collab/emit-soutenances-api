# =============================================================================
# CONFIGURATION LOCALE — Gestion Soutenance Master
# Copier ce fichier vers .env et compléter les valeurs marquées <...>
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Gestion Soutenance Master"
APP_ENV=local
APP_KEY=base64:<exécuter: php artisan key:generate>
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de données — SQLite (local, zéro config serveur)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# PostgreSQL (décommenter pour prod) :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=gestion_soutenances
# DB_USERNAME=postgres
# DB_PASSWORD=<votre_mot_de_passe>

# ---------------------------------------------------------------------------
# Session / Cache / Queue — drivers locaux (file/sync) — aucune table requise
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=file

QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Sanctum (API tokens)
# ---------------------------------------------------------------------------
SANCTUM_EXPIRATION=10080

# ---------------------------------------------------------------------------
# Stockage / Broadcast
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_DISK_DOCUMENTS=local

# ---------------------------------------------------------------------------
# E-mail (SMTP) — développement : 'log' écrit dans storage/logs/laravel.log
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Pour envoi réel (Gmail exemple) :
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=votre.adresse@gmail.com
# MAIL_PASSWORD=<mot_de_passe_application_16_caracteres>

PASSWORD_RESET_CODE_TTL=30

# ---------------------------------------------------------------------------
# Cloud storage (optionnel — commenter si non utilisé)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_REGION=
# R2_URL=
# R2_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# CORS — frontends autorisés (séparés par des virgules)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Jeu de données de démonstration (seeder)
# ---------------------------------------------------------------------------
# SEEDER_PASSWORD=password

# ---------------------------------------------------------------------------
# Frontend (variables injectées par Vite)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="http://127.0.0.1:8000/api"
