APP_NAME="Gestion Soutenance Master"
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# PostgreSQL (recommandé, conforme au livre) :
#   DB_CONNECTION=pgsql
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#   DB_DATABASE=gestion_soutenances
#   DB_USERNAME=postgres
#   DB_PASSWORD=votre_mot_de_passe
#
# SQLite (test rapide, aucun serveur requis) :
#   DB_CONNECTION=sqlite
#   et créer le fichier : database/database.sqlite (touch database/database.sqlite)

DB_CONNECTION=
DB_DATABASE=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

SANCTUM_EXPIRATION=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_DISK_DOCUMENTS=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# ---------------------------------------------------------------------------
# E-mail (SMTP)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

PASSWORD_RESET_CODE_TTL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=

CORS_ALLOWED_ORIGINS=

# Jeu de données de démonstration (seeder)
SEEDER_PASSWORD=

VITE_APP_NAME=
VITE_API_URL=
